# ============================================================
# B站探店 MCP 服务 — 环境变量配置示例
# 复制此文件为 .env 并填入实际值：cp .env.example .env
# ============================================================

# --- B站相关凭据 (从浏览器 Cookie 中获取) ---
BILIBILI_SESSDATA=your_sessdata_here
BILIBILI_BILI_JCT=your_bili_jct_here
BILIBILI_BUVID3=your_buvid3_here

# --- LLM 推理模型配置 (推荐使用 DeepSeek，性价比高) ---
# 若使用 DeepSeek:
OPENAI_API_KEY=sk-your-deepseek-api-key
OPENAI_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat
# 若使用 OpenAI 官方:
# OPENAI_API_KEY=sk-your-openai-api-key
# OPENAI_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4o

# --- Embedding 向量模型配置 (可独立于 LLM 配置) ---
# 推荐使用 OpenAI text-embedding-3-small
EMBEDDING_API_KEY=sk-your-openai-api-key
EMBEDDING_BASE_URL=https://api.openai.com/v1
EMBEDDING_MODEL=text-embedding-3-small

# --- 高德地图 Web 服务 API Key (用于 POI 搜索与地理编码) ---
AMAP_API_KEY=your_amap_web_service_key_here

# --- PostgreSQL 关系数据库 (存储结构化元数据) ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_DB=food_recommendation
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_password_here

# --- Neo4j 图数据库 (存储多UP主与探店知识图谱) ---
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=your_password_here

# --- Milvus 向量数据库 (存储菜品/评价稠密向量) ---
MILVUS_HOST=localhost
MILVUS_PORT=19530
MILVUS_COLLECTION=food_reviews

# --- Whisper ASR 语音转写 (本地或云端) ---
WHISPER_MODEL=large-v3
WHISPER_DEVICE=cuda

# --- 应用全局配置 ---
LOG_LEVEL=INFO
DATA_DIR=./data
